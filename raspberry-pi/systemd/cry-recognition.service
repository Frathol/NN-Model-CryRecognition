# systemd USER service (harus user service agar bisa mengakses PipeWire / mic Bluetooth)
# Dipasang oleh setup_pi.sh ke ~/.config/systemd/user/cry-recognition.service
[Unit]
Description=Smart Incubator - Cry Recognition
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
WorkingDirectory=__CRY_DIR__
EnvironmentFile=%h/.config/smart-incubator/cry.env
# Mic dipilih otomatis oleh cry_service.py: USB dulu (urut port), lalu Bluetooth
# (BT_MIC_MAC di cry.env disambungkan sendiri lewat scripts/connect_bt_mic.sh).
# Belum ada mic -> menunggu & langsung aktif saat mic dipasang (log: "Tidak ada mikrofon tersambung").
Environment=PYTHONUNBUFFERED=1
ExecStart=__CRY_DIR__/.venv/bin/python __CRY_DIR__/cry_service.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
